diff --git a/tests/ui/pocket.test.tsx b/tests/ui/pocket.test.tsx
new file mode 100644
index 0000000..bcf9f4a
--- /dev/null
+++ b/tests/ui/pocket.test.tsx
@@ -0,0 +1,49 @@
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, expect, it, vi } from "vitest";
+import App from "../../src/App";
+import { dataset, metadata, parcels } from "./fixtures";
+vi.mock("../../src/ParcelMap", () => ({default: ({onSelect}: {onSelect: (id: string) => void}) => <button onClick={() => onSelect("test-application")}>Testowy obrys</button>}));
+afterEach(() => {vi.unstubAllGlobals(); vi.restoreAllMocks();});
+async function loaded() {
+  Object.defineProperty(HTMLElement.prototype, "scrollIntoView", {configurable: true, value: vi.fn()});
+  vi.stubGlobal("matchMedia", vi.fn(() => ({matches: true})));
+  vi.stubGlobal("fetch", vi.fn(async (url: string) => ({ok: true, json: async () => url.includes("permits.json") ? dataset : url.includes("parcels.geojson") ? parcels : metadata})));
+  const app = render(<App />);
+  await waitFor(() => expect(screen.getByTestId("data-status")).toHaveAttribute("data-state", "ready"));
+  fireEvent.change(screen.getByLabelText("Okres"), {target: {value: "all"}});
+  return app;
+}
+it("opens progressive filters from the thumb navigation without resetting the search", async () => {
+  const {container} = await loaded();
+  const filters = container.querySelector("details.filter-disclosure")!;
+  expect(filters).not.toHaveAttribute("open");
+  fireEvent.change(screen.getByLabelText("Szukaj w rejestrze"), {target: {value: "domu"}});
+  fireEvent.click(screen.getByRole("button", {name: /Pokaż filtry/}));
+  expect(filters).toHaveAttribute("open");
+  expect(screen.getByLabelText("Okres")).toHaveFocus();
+  fireEvent.click(screen.getByRole("button", {name: /Pokaż filtry/}));
+  expect(filters).not.toHaveAttribute("open");
+  expect(screen.getByLabelText("Szukaj w rejestrze")).toHaveValue("domu");
+});
+it("shows a mobile list selection as a peek, then reversibly expands inspection", async () => {
+  const {container} = await loaded();
+  fireEvent.click(screen.getByRole("button", {name: /Lista/}));
+  fireEvent.click(screen.getByRole("button", {name: /TEST: budowa domu/}));
+  expect(container.querySelector(".workspace")).toHaveClass("view-map");
+  expect(container.querySelector(".detail-panel")).toHaveAttribute("data-inspection", "peek");
+  const disclosure = container.querySelector("details.inspection-body")!;
+  expect(disclosure).not.toHaveAttribute("open");
+  fireEvent.click(screen.getByRole("button", {name: "Testowy obrys"}));
+  expect(disclosure).toHaveAttribute("open");
+  expect(container.querySelector(".detail-panel")).toHaveAttribute("data-inspection", "full");
+  expect(container.querySelector(".detail-panel")).toHaveFocus();
+  (disclosure as HTMLDetailsElement).open = false;
+  fireEvent(disclosure, new Event("toggle"));
+  await waitFor(() => expect(container.querySelector(".detail-panel")).toHaveAttribute("data-inspection", "peek"));
+  fireEvent.click(screen.getByRole("button", {name: "Testowy obrys"}));
+  await waitFor(() => expect(disclosure).toHaveAttribute("open"));
+  fireEvent.keyDown(document, {key: "Escape"});
+  expect(container.querySelector(".detail-panel")).not.toBeInTheDocument();
+  expect(container.querySelector(".workspace")).toHaveClass("view-map");
+  expect(screen.getByLabelText("Okres")).toHaveValue("all");
+});
