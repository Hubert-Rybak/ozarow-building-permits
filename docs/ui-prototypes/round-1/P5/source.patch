+* { box-sizing: border-box; }
+body { margin: 0; }
+button, input, select { font: inherit; color: inherit; }
+button, a, input, select, summary { -webkit-tap-highlight-color: transparent; }
+button, summary { cursor: pointer; }
+button:disabled { opacity: .45; cursor: not-allowed; }
+a { color: var(--green); text-underline-offset: 3px; }
+button:focus-visible, a:focus-visible, summary:focus-visible, input:focus-visible, select:focus-visible, [tabindex]:focus-visible { outline: 3px solid #245bce; outline-offset: 3px; }
+h1,h2,h3,h4,p { margin: 0; }
+ul { padding: 0; margin: 0; }
+button, select, .header-link, .source-button { min-height: 44px; }
+.muted { font-size: 12px; line-height: 1.7; color: var(--muted); }
+.eyebrow { font-size: 10px; font-weight: 600; letter-spacing: .5px; color: var(--muted); }
+.skip-link { position: fixed; top: -100px; left: 16px; z-index: 2000; background: white; padding: 14px; }
+.skip-link:focus { top: 10px; }
+.masthead { height: 72px; padding: 12px 32px; display: flex; align-items: center; justify-content: space-between; gap: 12px; background: white; border-bottom: 1px solid var(--line); }
+.brand { display: flex; gap: 12px; align-items: center; min-width: 0; }
+.brand-mark { width: 40px; height: 40px; display: grid; place-items: center; color: var(--green); background: var(--soft); border-radius: 13px; flex-shrink: 0; }
+.brand-mark svg { width: 25px; height: 25px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
+.masthead h1 { font-size: 17px; letter-spacing: -.4px; }
+.masthead h1 span { font-weight: 400; color: var(--muted); }
+.masthead p { display: none; }
+.header-link { display: flex; align-items: center; border-radius: 12px; padding: 0 13px; font-size: 12px; color: var(--muted); text-decoration: none; }
+.header-link:hover { background: var(--soft); }
+main { max-width: 1600px; margin: 0 auto; padding: 18px 32px 0; display: flex; flex-direction: column; }
+.intro { order: 0; margin: 0 0 14px; }
+.intro h2 { font-size: 23px; letter-spacing: -.8px; }
+.toolbar { order: 1; position: relative; z-index: 800; display: grid; grid-template-columns: minmax(0, 480px) 200px; gap: 12px; align-items: start; }
+.search-wrap { min-width: 0; }
+.search-wrap > label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
+.search-input { height: 50px; border: 1px solid var(--line); background: white; border-radius: 15px; display: flex; align-items: center; box-shadow: 0 2px 7px #253c5b05; }
+.search-input:focus-within { border-color: var(--green); box-shadow: 0 0 0 3px #235bce20; }
+.search-input span { display: grid; place-items: center; width: 44px; flex-shrink: 0; }
+.search-input svg { width: 20px; height: 20px; fill: none; stroke: var(--muted); stroke-width: 1.8; }
+.search-input input { flex: 1; min-width: 0; width: 100%; height: 100%; padding: 0 12px 0 0; border: 0; outline: none; background: transparent; font-size: 14px; }
+.search-input input::placeholder { color: #788493; }
+.filter-disclosure { border: 1px solid var(--line); background: white; border-radius: 15px; }
+.filter-disclosure > summary { display: flex; align-items: center; justify-content: space-between; min-height: 48px; padding: 0 15px; font-size: 12px; font-weight: 600; list-style: none; gap: 8px; }
+.filter-disclosure > summary::before { content: "☷"; font-size: 18px; color: var(--green); }
+.filter-disclosure > summary span { font-size: 11px; font-weight: 400; color: var(--muted); }
+.filter-disclosure[open] { position: absolute; top: 0; left: 492px; width: min(560px, calc(100% - 492px)); box-shadow: var(--shadow); padding: 0 16px 8px; }
+.filter-disclosure[open] > summary { padding: 0; }
+.filter-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 14px 12px; padding-top: 12px; border-top: 1px solid var(--line); }
+.filter-grid label { display: flex; flex-direction: column; gap: 6px; min-width: 0; font-size: 11px; color: var(--muted); font-weight: 600; }
+select { border: 1px solid var(--line); border-radius: 10px; background: white; min-width: 0; max-width: 100%; width: 100%; font-size: 12px; padding: 0 28px 0 10px; text-overflow: ellipsis; }
+.toolbar-bottom { display: flex; justify-content: flex-end; padding-top: 7px; }
+.text-button { background: none; border: 0; color: var(--green); padding: 8px; font-size: 12px; }
+.filter-number { background: var(--soft); margin-left: 5px; padding: 2px 6px; border-radius: 6px; }
+.summary-strip { order: 2; display: flex; gap: 22px; padding: 14px 2px; }
+.summary-strip > div { display: flex; align-items: baseline; gap: 6px; min-width: 0; }
+.summary-strip strong { font-size: 15px; font-variant-numeric: tabular-nums; }
+.summary-strip span { font-size: 11px; color: var(--muted); }
+.workspace, .workspace.has-detail { order: 3; position: relative; display: grid; grid-template-columns: minmax(0,1fr) 340px; gap: 16px; align-items: start; }
+.map-panel, .results-panel, .detail-panel { min-width: 0; border: 1px solid var(--line); background: white; border-radius: var(--radius); overflow: hidden; }
+.map-panel { scroll-margin-top: 12px; }
+.map-shell { height: min(70vh, 760px); min-height: 440px; position: relative; background: #e9eee8; }
+.leaflet-map { width: 100%; height: 100%; z-index: 0; }
+.leaflet-container { font-family: inherit; background: #e9eee8; }
+.leaflet-tile-pane { filter: saturate(.6) contrast(.94) brightness(1.04); }
+.leaflet-control-zoom { border: 1px solid var(--line) !important; border-radius: 14px !important; overflow: hidden; box-shadow: var(--shadow) !important; }
+.leaflet-control-zoom a { width: 44px !important; height: 44px !important; line-height: 44px !important; font-size: 21px !important; color: var(--navy) !important; }
+.leaflet-container .leaflet-control-attribution { font-size: 9px; color: var(--muted); background: #ffffffe8; }
+.map-overview { position: absolute; top: 12px; left: 12px; z-index: 400; display: flex; align-items: center; gap: 8px; background: white; border: 1px solid var(--line); border-radius: 14px; padding: 0 13px; font-size: 11px; box-shadow: var(--shadow); }
+.map-overview span { display: flex; }
+.map-legend { position: absolute; left: 12px; bottom: 27px; z-index: 400; background: #fffffff5; border: 1px solid var(--line); border-radius: 14px; font-size: 11px; padding: 0 12px; max-width: calc(100% - 24px); box-shadow: var(--shadow); }
+.map-legend summary { display: flex; align-items: center; min-height: 44px; font-size: 11px; font-weight: 600; }
+.map-legend summary::before { content: "◉"; color: var(--green); margin-right: 7px; }
+.map-legend ul { list-style: none; padding: 0 0 6px; }
+.map-legend li { display: flex; gap: 8px; align-items: center; line-height: 2; }
+.map-legend li span { width: 9px; height: 9px; border-radius: 3px; }
+.map-legend p { font-size: 10px; color: var(--muted); border-top: 1px solid var(--line); padding: 8px 0; }
+.map-caption { display: flex; gap: 10px; align-items: center; justify-content: space-between; padding: 10px 14px; font-size: 10px; color: var(--muted); min-height: 36px; }
+.map-caption strong { font-weight: 500; }
+.tile-warning { position: absolute; z-index: 500; right: 10px; bottom: 24px; max-width: 220px; font-size: 11px; padding: 10px; border-radius: 10px; background: #fff5d8; color: #69552b; }
+.results-panel { height: calc(min(70vh, 760px) + 36px); display: flex; flex-direction: column; }
+.results-top { display: flex; justify-content: space-between; align-items: center; padding: 14px; gap: 8px; }
+.results-top h2 { font-size: 18px; letter-spacing: -.5px; }
+.results-top h2 span { margin-left: 7px; font-size: 12px; color: var(--muted); font-weight: 400; }
+.csv-button { border: 1px solid var(--line); border-radius: 10px; background: white; color: var(--green); padding: 0 10px; font-size: 11px; }
+.sort-control { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 14px; border-bottom: 1px solid var(--line); font-size: 11px; color: var(--muted); }
+.sort-control select { max-width: 190px; }
+.result-list { list-style: none; flex: 1; overflow: auto; scrollbar-width: thin; overscroll-behavior: contain; }
+.result-list li + li { border-top: 1px solid var(--line); }
+.result-row { display: block; width: 100%; border: 0; border-left: 3px solid transparent; background: white; text-align: left; padding: 15px 13px; }
+.result-row:hover { background: #f7f9fe; }
+.result-row.selected { border-left-color: var(--green); background: var(--soft); }
+.result-row:focus-visible { outline-offset: -4px; }
+.row-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
+.row-top time { font-size: 11px; color: var(--muted); white-space: nowrap; }
+.badge { display: inline-flex; padding: 3px 7px; border-radius: 6px; font-size: 10px; font-weight: 600; max-width: 100%; overflow-wrap: anywhere; }
+.badge.approved { background: #e6f3e9; color: #246140; }
+.badge.pending { background: #fff1d8; color: #7c5a16; }
+.badge.refused { background: #fae5e2; color: #94443a; }
+.badge.withdrawn { background: #eceef2; color: #585f6b; }
+.badge.unknown { background: #eaf0f9; color: #476282; }
+.badge.neutral { background: #f2f4f6; color: #586573; }
+.result-row h3 { margin: 9px 0 4px; font-size: 13px; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
+.row-place { font-size: 12px; color: var(--muted); }
+.row-bottom { margin-top: 10px; display: flex; justify-content: space-between; gap: 8px; font-size: 10px; color: var(--muted); }
+.row-bottom > span:first-child { min-width: 0; overflow-wrap: anywhere; }
+.row-bottom > span:last-child { flex-shrink: 0; }
+.mapped-label { color: #476282; }
+.detail-panel { position: absolute; z-index: 600; bottom: 52px; left: 16px; width: min(420px, calc(100% - 390px)); padding: 16px; max-height: min(65vh,580px); overflow: auto; box-shadow: 0 12px 48px #1d334833; scrollbar-width: thin; }
+.detail-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 10px; }
+.detail-top > div { min-width: 0; }
+.detail-top h2 { font-size: 11px; color: var(--muted); font-weight: 400; }
+.detail-top .eyebrow { font-size: 11px; color: var(--navy); letter-spacing: 0; }
+.icon-button { width: 44px; height: 44px; flex-shrink: 0; border: 0; background: #f2f4f7; border-radius: 50%; font-size: 25px; }
+.record-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
+.detail-panel > h3 { font-size: 17px; line-height: 1.4; overflow-wrap: anywhere; margin-bottom: 8px; }
+.inspection-body > summary { min-height: 44px; padding: 12px 0; font-size: 12px; font-weight: 600; color: var(--green); }
+.semantic-note { font-size: 12px; line-height: 1.7; color: #526173; background: #f2f5fa; padding: 12px; border-radius: 10px; margin: 4px 0 14px; }
+.description { font-size: 12px; line-height: 1.8; color: var(--muted); white-space: pre-line; overflow-wrap: anywhere; margin-bottom: 14px; }
+.detail-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 16px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 16px 0; margin: 0 0 14px; }
+.detail-grid dt { font-size: 10px; color: var(--muted); margin-bottom: 3px; }
+.detail-grid dd { margin: 0; font-size: 12px; overflow-wrap: anywhere; }
+.detail-panel h4 { font-size: 13px; margin-bottom: 8px; }
+.parcel-numbers, .geometry-note { font-size: 12px; line-height: 1.7; color: var(--muted); overflow-wrap: anywhere; margin: 10px 0; }
+.parcel-list { list-style: none; }
+.parcel-list li { display: flex; flex-direction: column; gap: 4px; margin: 8px 0; padding: 12px; border: 1px solid var(--line); border-radius: 10px; font-size: 11px; overflow-wrap: anywhere; }
+.parcel-list code, .parcel-identifiers code { font-size: 10px; overflow-wrap: anywhere; }
+.parcel-list a { display: flex; align-items: center; min-height: 44px; }
+.parcel-identifiers { font-size: 12px; }
+.parcel-identifiers summary { min-height: 44px; padding: 12px 0; }
+.parcel-identifiers ul { padding-left: 16px; }
+.detail-source { border-top: 1px solid var(--line); padding-top: 14px; margin-top: 14px; }
+.source-button { display: inline-flex; align-items: center; padding: 0 14px; background: var(--soft); border-radius: 10px; text-decoration: none; font-size: 12px; }
+.detail-source small { display: block; color: var(--muted); font-size: 9px; margin-top: 10px; overflow-wrap: anywhere; }
+.empty-state { flex: 1; min-height: 280px; padding: 30px 18px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 10px; }
+.empty-state h3 { font-size: 15px; }
+.empty-state p { font-size: 12px; color: var(--muted); max-width: 290px; }
+.empty-state > span { font-size: 36px; color: var(--muted); }
+.loading-ring { width: 28px; height: 28px; border: 2px solid var(--line); border-top-color: var(--green); border-radius: 50%; animation: spin 1s linear infinite; }
+@keyframes spin { to { transform: rotate(360deg); } }
+.data-status { order: 4; display: flex; align-items: center; gap: 6px; font-size: 10px; color: var(--muted); padding: 14px 2px 6px; flex-wrap: wrap; }
+.status-dot { width: 5px; height: 5px; border-radius: 50%; background: #4b8062; }
+.status-date { margin-left: auto; }
+.warnings { order: 5; font-size: 11px; color: #685934; }
+.warnings summary { min-height: 44px; padding: 12px 2px; }
+.warnings ul { padding: 10px 20px; border-radius: 10px; background: #fff7e4; line-height: 1.8; overflow-wrap: anywhere; }
+.error-state { order: 2; background: #fff0ee; border: 1px solid #e7c0ba; border-radius: 12px; padding: 16px; color: #753d35; margin: 12px 0; }
+.error-state h2 { font-size: 18px; }
+.error-state p { font-size: 12px; padding: 8px 0; overflow-wrap: anywhere; }
+.primary-button { border: 0; background: var(--green); color: white; border-radius: 10px; padding: 0 16px; font-size: 13px; }
+.data-disclosure { order: 6; border-top: 1px solid var(--line); margin-top: 4px; }
+.data-disclosure > summary { min-height: 44px; padding: 12px 2px; font-size: 12px; }
+.provenance { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 40px; padding: 12px 0 24px; }
+.provenance h2 { font-size: 20px; }
+.provenance h3 { font-size: 13px; }
+.provenance p { font-size: 12px; line-height: 1.8; color: var(--muted); margin: 9px 0; overflow-wrap: anywhere; }
+.source-info a { display: inline-flex; align-items: center; min-height: 44px; font-size: 12px; }
+.coverage-note { background: #fff7e4; padding: 12px; border-radius: 10px; }
+.parcel-popup > strong { font-size: 13px; }
+.parcel-popup > p { overflow-wrap: anywhere; font-size: 10px !important; color: var(--muted); margin: 7px 0 !important; }
+.parcel-popup button { width: 100%; text-align: left; padding: 10px; border: 1px solid var(--line); border-radius: 9px; background: #f3f6fb; margin-top: 7px; font-size: 11px; }
+footer { max-width: 1600px; margin: 0 auto; padding: 16px 32px 24px; display: flex; justify-content: space-between; gap: 16px; border-top: 1px solid var(--line); font-size: 10px; color: var(--muted); }
+.mobile-tabs { display: none; }
+@media (max-width: 1000px) and (min-width: 721px) {
+  main { padding: 16px; }
+  .workspace, .workspace.has-detail { grid-template-columns: minmax(0,1fr) 300px; gap: 12px; }
+  .detail-panel { width: calc(100% - 330px); left: 8px; }
+  .toolbar { grid-template-columns: minmax(0,1fr) 200px; }
+  .filter-disclosure[open] { right: 0; left: auto; width: min(560px,100%); }
+  .summary-strip { gap: 14px; }
+  .summary-strip span { font-size: 10px; }
 }
