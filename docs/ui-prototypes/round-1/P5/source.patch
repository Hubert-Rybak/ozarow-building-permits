+  .mobile-tabs { position: fixed; bottom: 0; left: 0; right: 0; z-index: 1000; display: flex; gap: 6px; margin: 0; padding: 8px 16px calc(8px + env(safe-area-inset-bottom)); background: #fffffff7; border-top: 1px solid var(--line); box-shadow: 0 -4px 20px #22355008; }
+  .mobile-tabs button { flex: 1; min-width: 0; min-height: 56px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 4px; border: 0; background: none; border-radius: 15px; color: var(--muted); font-size: 11px; font-weight: 600; }
+  .mobile-tabs svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
+  .mobile-tabs button[aria-pressed="true"], .mobile-tabs button[aria-expanded="true"] { background: var(--soft); color: var(--green); }
+  .data-status { margin: 0 12px; padding-top: 10px; font-size: 9px; }
+  .status-date { font-size: 9px; margin-left: 0; }
+  .warnings { margin: 0 12px; }
+  .warnings summary { font-size: 10px; }
+  .data-disclosure { margin: 0 12px; }
+  .provenance { grid-template-columns: minmax(0,1fr); gap: 12px; }
+  .error-state { margin: 12px; }
+  .tile-warning { max-width: 155px; font-size: 10px; }
+  footer { margin: 0 12px; padding: 14px 0; display: block; }
+  footer span { display: block; margin-top: 4px; }
