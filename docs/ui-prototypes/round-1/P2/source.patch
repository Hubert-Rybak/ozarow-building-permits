+.detail-source { border-top: 1px solid var(--line); padding-top: 15px; margin-top: 20px; }
+.source-button { display: inline-flex; align-items: center; min-height: 44px; border: 1px solid #c5d5d8; border-radius: 8px; background: #edf4f6; padding: 10px 14px; text-decoration: none; font-size: 13px; font-weight: 600; }
+.detail-source small { display: block; font-size: 10px; color: var(--muted); margin-top: 10px; overflow-wrap: anywhere; }
+.data-disclosure { margin-top: 23px; border-top: 1px solid var(--line); padding: 13px 0; }
+.data-disclosure > summary { cursor: pointer; font-size: 14px; font-weight: 600; min-height: 44px; padding: 10px 2px; }
+.provenance { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; padding: 12px 0; }
+.provenance h2 { font-size: 22px; font-weight: 700; }
+.provenance p { font-size: 13px; color: var(--muted); line-height: 1.85; margin: 10px 0; overflow-wrap: anywhere; }
+.source-info h3 { font-size: 15px; font-weight: 600; }
+.source-info a { font-size: 13px; min-height: 44px; display: inline-flex; align-items: center; }
+.coverage-note { background: #fbf8ed; border: 1px solid #e4dcc5; border-left: 3px solid #b58038; border-radius: 7px; padding: 13px; color: #76603b !important; }
+.parcel-popup > strong { font-size: 14px; color: var(--green); }
+.parcel-popup > p { font-size: 11px !important; color: var(--muted); overflow-wrap: anywhere; }
+.parcel-popup button { min-height: 44px; width: 100%; border: 1px solid var(--line); background: #edf4f6; border-radius: 7px; padding: 10px; margin-top: 7px; font-size: 12px; text-align: left; }
+.leaflet-interactive:focus-visible { outline: 3px solid #b58038; }
+footer { max-width: 1440px; padding: 15px 32px 22px; margin: 0 auto; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 16px; font-size: 11px; color: var(--muted); }
+.workspace.has-detail { grid-template-columns: 320px minmax(0,1fr) 355px; }
+.workspace.view-list:not(.has-detail) { grid-template-columns: minmax(0,1fr) 0; }
+.workspace.view-list:not(.has-detail) .map-panel { visibility: hidden; }
+.workspace.view-list:not(.has-detail) .result-list { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); align-content: start; gap: 12px; }
+.workspace.view-list:not(.has-detail) .result-list li + li { margin-top: 0; }
+@media (max-width: 1100px) {
+  .toolbar { grid-template-columns: minmax(0,1fr) auto; }
+  .toolbar-bottom { grid-column: 2; justify-self: end; }
+  .workspace,.workspace.has-detail { grid-template-columns: 345px minmax(0,1fr); }
+  .detail-panel { grid-column: 1/-1; grid-row: 2; max-height: none; }
+  .map-caption { flex-direction: column; align-items: flex-start; }
+  .summary-strip span { font-size: 11px; }
+  .summary-strip > div { padding-left: 12px; }
 }
