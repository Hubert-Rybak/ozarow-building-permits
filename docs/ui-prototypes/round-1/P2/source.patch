+.detail-panel h4 { font-size: 15px; font-weight: 600; margin-bottom: 8px; }
+.parcel-numbers,.geometry-note { font-size: 13px; color: var(--muted); line-height: 1.75; overflow-wrap: anywhere; }
+.geometry-note { margin: 11px 0; }
