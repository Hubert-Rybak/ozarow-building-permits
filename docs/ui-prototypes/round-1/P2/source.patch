@@ -0,0 +1,43 @@
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, expect, it, vi } from "vitest";
+import { readFileSync } from "node:fs";
+import App from "../../src/App";
+import { dataset, metadata, parcels } from "./fixtures";
+vi.mock("../../src/ParcelMap", () => ({default: () => <div className="leaflet-map" />}));
+afterEach(() => vi.unstubAllGlobals());
+const ready = async () => {
+  vi.stubGlobal("fetch", vi.fn(async (url: string) => ({ok: true, json: async () => url.includes("permits.json") ? dataset : url.includes("parcels.geojson") ? parcels : metadata})));
+  const result = render(<App />);
+  await waitFor(() => expect(screen.getByTestId("data-status")).toHaveAttribute("data-state", "ready"));
+  return result;
+};
+it("discloses secondary filters in a keyboard dismissible drawer without resetting them or the map", async () => {
+  const {container} = await ready();
+  const map = container.querySelector(".leaflet-map");
+  expect(container.querySelector('[aria-controls="filter-drawer"]')).not.toBeNull();
+  const trigger = screen.getByRole("button", {name: /Więcej filtrów/});
+  expect(trigger).toHaveAttribute("aria-expanded", "false");
+  expect(screen.getByLabelText("Okres")).toBeVisible();
+  fireEvent.click(trigger);
+  expect(trigger).toHaveAttribute("aria-expanded", "true");
+  expect(screen.getByRole("dialog", {name: "Filtry wpisów"})).toBeVisible();
+  await waitFor(() => expect(screen.getByRole("button", {name: "Zamknij filtry"})).toHaveFocus());
+  fireEvent.change(screen.getByLabelText("Rodzaj wpisu"), {target: {value: "decision"}});
+  fireEvent.keyDown(screen.getByRole("dialog"), {key: "Escape"});
+  expect(trigger).toHaveAttribute("aria-expanded", "false");
+  expect(trigger).toHaveFocus();
+  expect(screen.getByLabelText("Rodzaj wpisu")).toHaveValue("decision");
+  expect(container.querySelector(".leaflet-map")).toBe(map);
+});
+it("compiles genuine locally installed Tailwind and daisyUI components, with no remote CSS", () => {
+  const css = readFileSync("src/styles.css", "utf8");
+  const config = readFileSync("vite.config.ts", "utf8");
+  const source = readFileSync("src/App.tsx", "utf8");
+  expect(config).toContain('tailwindcss()');
+  expect(css).toContain('@import "tailwindcss"');
+  expect(css).toContain('@plugin "daisyui"');
+  expect(css).not.toMatch(/@import.*https?:/);
+  expect(source).toContain("drawer-side");
+  expect(source).toContain("btn-primary");
+  expect(source).toContain("select select-bordered");
+});
