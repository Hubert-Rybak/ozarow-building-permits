+}
+* { box-sizing: border-box; }
+body { margin: 0; }
+h1,h2,h3,h4,p { margin: 0; }
+button,input,select { font: inherit; }
+button,a,input,select,summary { -webkit-tap-highlight-color: transparent; }
+button { cursor: pointer; color: inherit; }
+button:disabled { cursor: not-allowed; opacity: .5; }
+a { color: var(--green); text-underline-offset: 3px; }
+ul { margin: 0; padding: 0; }
+button:focus-visible,a:focus-visible,summary:focus-visible,input:focus-visible,select:focus-visible,[tabindex]:focus-visible { outline: 3px solid #b58038; outline-offset: 3px; }
+.btn { min-height: 44px; font-size: 13px; font-weight: 600; box-shadow: none; }
+.btn-primary { color: var(--color-primary-content); }
+.btn-square { width: 44px; }
+body:has(.drawer-toggle:checked) { overflow: hidden; }
+.registry-source { display: inline-flex; align-items: center; min-height: 44px; }
+.select { min-height: 44px; height: 44px; width: 100%; min-width: 0; font-size: 13px; color: var(--navy); text-overflow: ellipsis; }
+.muted { color: var(--muted); font-size: 12px; line-height: 1.7; }
+.eyebrow { color: #537466; font-size: 10px; font-weight: 700; letter-spacing: 1.6px; }
+.skip-link { position: fixed; top: -100px; left: 16px; z-index: 2200; padding: 14px; background: white; }
+.skip-link:focus { top: 10px; }
+.masthead { min-height: 80px; padding: 15px max(32px, calc((100vw - 1376px)/2)); border-bottom: 1px solid var(--line); gap: 20px; justify-content: space-between; }
+.brand { display: flex; align-items: center; gap: 12px; min-width: 0; }
+.brand-mark { display: grid; place-items: center; width: 44px; height: 44px; background: #edf2e9; border-radius: 12px; flex-shrink: 0; }
+.brand-mark svg { width: 30px; height: 30px; fill: none; stroke: #436951; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
+.masthead h1 { font-size: 20px; font-weight: 750; letter-spacing: -.5px; }
+.masthead h1 span { font-weight: 500; color: #536967; }
+.masthead p { font-size: 11px; margin-top: 2px; color: var(--muted); }
+.header-link { text-decoration: none; white-space: nowrap; }
+main { max-width: 1440px; margin: 0 auto; padding: 22px 32px 0; }
+.intro { margin-bottom: 18px; }
+.intro h2 { font-size: 30px; letter-spacing: -1px; font-weight: 720; }
+.toolbar { display: grid; grid-template-columns: minmax(200px, 1fr) auto auto; align-items: end; padding: 15px 18px; gap: 18px; border: 1px solid var(--line); position: relative; }
+.search-wrap > label,.period-control { font-size: 12px; font-weight: 600; color: #536967; }
+.search-input { margin-top: 5px; width: 100%; height: 46px; min-height: 46px; display: flex; gap: 10px; padding: 0 13px; border-color: #c9d4d2; background: white; }
+.search-input:focus-within { outline: 3px solid #b58038; outline-offset: 2px; }
+.search-input span { display: grid; place-items: center; }
+.search-input svg { width: 18px; height: 18px; stroke: #677e7b; fill: none; stroke-width: 1.8; }
+.search-input input { flex: 1; min-width: 0; height: 100%; border: 0; background: transparent; outline: none; font-size: 14px; }
+.search-input input::placeholder { color: #788881; }
+.quick-filters { display: flex; align-items: end; gap: 12px; }
+.period-control { display: flex; flex-direction: column; gap: 5px; width: 205px; }
+.filter-trigger { white-space: nowrap; min-height: 46px; }
+.filter-trigger .badge { color: #245e77; background: white; border: 0; }
+.toolbar-bottom { align-self: end; }
