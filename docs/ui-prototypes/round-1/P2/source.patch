+.explore-navigation { display: flex; justify-content: space-between; align-items: center; margin: 16px 0 12px; gap: 12px; }
+.mobile-tabs { display: flex; border: 1px solid #c9d4d2; background: white; border-radius: 9px; padding: 3px; }
+.mobile-tabs .btn { background: transparent; border: 0; border-radius: 6px; min-width: 110px; color: #607078; }
+.mobile-tabs .btn[aria-pressed="true"] { background: #245e77; color: white; }
+.explore-hint { font-size: 12px; color: var(--muted); }
+.workspace { display: grid; grid-template-columns: 405px minmax(0,1fr); gap: 18px; align-items: start; }
+.map-panel,.results-panel,.detail-panel { min-width: 0; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; background: white; }
+.map-panel { grid-column: 2; grid-row: 1; position: sticky; top: 16px; }
+.results-panel { grid-column: 1; grid-row: 1; display: flex; flex-direction: column; height: 605px; }
+.map-shell { height: 550px; position: relative; background: #e8eee7; }
