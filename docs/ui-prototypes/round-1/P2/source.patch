+.leaflet-control-zoom a { width: 44px !important; height: 44px !important; line-height: 44px !important; color: var(--navy) !important; }
+.map-overview { position: absolute; z-index: 400; left: 12px; top: 12px; min-height: 44px; display: flex; align-items: center; gap: 7px; border: 1px solid #c9d4d2; border-radius: 8px; padding: 10px 12px; background: white; font-size: 12px; font-weight: 600; box-shadow: 0 2px 6px #203c4710; }
+.map-legend { position: absolute; z-index: 400; left: 12px; bottom: 25px; width: 215px; border: 1px solid #c9d4d2; border-radius: 8px; background: #fffffff5; font-size: 11px; }
+.map-legend summary { min-height: 44px; padding: 13px 12px; cursor: pointer; font-size: 12px; font-weight: 600; }
+.map-legend ul { list-style: none; padding: 0 12px 8px; }
+.map-legend li { display: flex; gap: 8px; align-items: center; line-height: 2; }
+.map-legend li span { width: 9px; height: 9px; border-radius: 2px; }
+.map-legend p { padding: 7px 12px 10px; border-top: 1px solid var(--line); font-size: 10px; }
+.map-caption { padding: 11px 15px; display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 54px; font-size: 11px; color: var(--muted); }
+.map-caption strong { font-weight: 600; color: #385b48; }
+.tile-warning { position: absolute; z-index: 400; right: 8px; bottom: 12px; max-width: 220px; background: #fff7d8; color: #6d5a26; border: 1px solid #d9cb96; border-radius: 6px; padding: 8px; font-size: 11px; }
+.results-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 16px; }
+.results-top h2 { font-size: 22px; font-weight: 720; }
+.results-top h2 span { margin-left: 8px; font-size: 12px; background: #eaf0ed; color: #537466; padding: 3px 7px; border-radius: 5px; vertical-align: middle; }
