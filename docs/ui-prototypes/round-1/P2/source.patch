+.warnings summary { padding: 11px 13px; cursor: pointer; min-height: 44px; }
+.warnings ul { margin: 0 16px 14px 30px; line-height: 1.8; overflow-wrap: anywhere; list-style: disc; }
+.error-state { background: #fff1ed; border: 1px solid #e6c9bd; border-radius: 12px; padding: 22px; margin-top: 12px; }
+.error-state h2 { font-size: 20px; font-weight: 700; }
