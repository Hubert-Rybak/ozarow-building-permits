@@ -0,0 +1,61 @@
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { afterEach, expect, it, vi } from "vitest";
+import { readFileSync } from "node:fs";
+import App from "../../src/App";
+import { dataset, metadata, parcels } from "./fixtures";
+vi.mock("../../src/ParcelMap", () => ({ default: () => <div aria-label="Mapa testowa" /> }));
+afterEach(() => { vi.unstubAllGlobals(); vi.restoreAllMocks(); });
+async function workspace() {
+  vi.stubGlobal("fetch", vi.fn(async (url: string) => ({ ok: true, json: async () => url.includes("permits.json") ? dataset : url.includes("parcels.geojson") ? parcels : metadata })));
+  const result = render(<App />);
+  await waitFor(() => expect(screen.getByTestId("data-status")).toHaveAttribute("data-state", "ready"));
+  fireEvent.change(screen.getByLabelText("Okres"), { target: { value: "all" } });
+  return result;
+}
+it("opens secondary filters explicitly and applies without resetting values", async () => {
+  const { container } = await workspace();
+  const toggle = screen.getByRole("button", { name: "Filtry szczegółowe" });
+  expect(toggle).toHaveAttribute("aria-expanded", "false");
+  expect(container.querySelector("#advanced-filters")).not.toBeVisible();
+  fireEvent.click(toggle);
+  expect(toggle).toHaveAttribute("aria-expanded", "true");
+  fireEvent.change(screen.getByLabelText("Miejscowość"), { target: { value: "Duchnice" } });
+  expect(screen.getByTestId("data-status")).toHaveAttribute("data-filtered-count", "1");
+  fireEvent.click(screen.getByRole("button", { name: "Pokaż przefiltrowane wyniki" }));
+  expect(toggle).toHaveAttribute("aria-expanded", "false");
+  expect(toggle).toHaveFocus();
+  expect(screen.getByLabelText("Miejscowość")).toHaveValue("Duchnice");
+  expect(screen.getByLabelText("Okres")).toHaveValue("all");
+});
+it("closes filter workbench with Escape and returns keyboard focus", async () => {
+  await workspace();
+  const toggle = screen.getByRole("button", { name: "Filtry szczegółowe" });
+  fireEvent.click(toggle);
+  const locality = screen.getByLabelText("Miejscowość");
+  locality.focus();
+  fireEvent.keyDown(locality, { key: "Escape" });
+  expect(toggle).toHaveAttribute("aria-expanded", "false");
+  expect(toggle).toHaveFocus();
+});
+it("clears search independently of period and secondary filters", async () => {
+  await workspace();
+  fireEvent.click(screen.getByRole("button", { name: "Filtry szczegółowe" }));
+  fireEvent.change(screen.getByLabelText("Miejscowość"), { target: { value: "Duchnice" } });
+  fireEvent.change(screen.getByLabelText("Szukaj w rejestrze"), { target: { value: "missing" } });
+  expect(screen.getByTestId("data-status")).toHaveAttribute("data-filtered-count", "0");
+  fireEvent.click(screen.getByRole("button", { name: "Wyczyść wyszukiwanie" }));
+  expect(screen.getByLabelText("Szukaj w rejestrze")).toHaveValue("");
+  expect(screen.getByLabelText("Szukaj w rejestrze")).toHaveFocus();
+  expect(screen.getByLabelText("Miejscowość")).toHaveValue("Duchnice");
+  expect(screen.getByLabelText("Okres")).toHaveValue("all");
+  expect(screen.getByTestId("data-status")).toHaveAttribute("data-filtered-count", "1");
+});
+it("uses local compiled Tailwind for components and a two-pane workspace", () => {
+  const css = readFileSync("src/styles.css", "utf8");
+  const config = readFileSync("vite.config.ts", "utf8");
+  expect(config).toContain("tailwindcss()");
+  expect(css).toContain('@import "tailwindcss"');
+  expect(css).toContain("@apply");
+  expect(css).not.toContain("fonts.googleapis.com");
+  expect(css).toMatch(/\.workspace\s*\{[^}]*grid-template-columns:\s*minmax\(0,\s*380px\)\s*minmax\(0,\s*1fr\)/);
+});
