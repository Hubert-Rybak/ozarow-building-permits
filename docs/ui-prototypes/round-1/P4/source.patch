+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { readFileSync } from "node:fs";
+import { afterEach, expect, it, vi } from "vitest";
+import App from "../../src/App";
+import { dataset, metadata, parcels } from "./fixtures";
+vi.mock("../../src/ParcelMap", () => ({ default: () => <div aria-label="Mapa testowa" /> }));
+afterEach(() => vi.unstubAllGlobals());
+const ready = async () => {
+  vi.stubGlobal("fetch", vi.fn(async (url: string) => ({ok:true, json:async()=>url.includes("permits.json") ? dataset : url.includes("parcels.geojson") ? parcels : metadata})));
+  const result = render(<App />);
+  fireEvent.change(screen.getByLabelText("Okres"), {target:{value:"all"}});
+  await waitFor(() => expect(screen.getByTestId("data-status")).toHaveAttribute("data-state","ready"));
+  return result;
+};
+it("keeps secondary filters in a closed native disclosure with current filter context", async () => {
+  const {container} = await ready();
+  const disclosure = container.querySelector("details.secondary-filters");
+  expect(disclosure).toBeInTheDocument();
+  expect(disclosure).not.toHaveAttribute("open");
+  expect(screen.getByLabelText("Rok wpisu").closest("details")).toBe(disclosure);
+  expect(screen.getByLabelText("Status w źródle").closest("details")).toBe(disclosure);
+  expect(screen.getByLabelText("Miejscowość").closest("details")).toBe(disclosure);
+  expect(screen.getByLabelText("Położenie na mapie").closest("details")).toBe(disclosure);
+  fireEvent.change(screen.getByLabelText("Miejscowość"), {target:{value:dataset.records[0].locality}});
+  expect(disclosure?.querySelector("summary")).toHaveTextContent("Filtry szczegółowe · 1 aktywny");
+  fireEvent.click(screen.getByRole("button",{name:"Wyczyść filtry"}));
+  expect(screen.getByLabelText("Miejscowość")).toHaveValue("");
+  expect(disclosure?.querySelector("summary")).toHaveTextContent("Filtry szczegółowe · brak aktywnych");
+});
+it("provides aligned register column context and a source action before the long geometry evidence", async () => {
+  const {container} = await ready();
+  expect(container.querySelector(".register-columns")).toHaveTextContent("Data / rodzaj");
+  expect(container.querySelector(".register-columns")).toHaveTextContent("Inwestycja / lokalizacja");
+  expect(container.querySelector(".register-columns")).toHaveTextContent("Działki / położenie");
+  fireEvent.click(screen.getByRole("button",{name:/TEST: budowa domu/}));
+  const source=screen.getByRole("link",{name:"Wpis w źródle"});
+  const evidence=container.querySelector(".detail-grid")!;
+  const title=container.querySelector(".detail-panel > h3")!;
+  expect(source.compareDocumentPosition(title) & Node.DOCUMENT_POSITION_FOLLOWING).toBeTruthy();
+  expect(source.compareDocumentPosition(evidence) & Node.DOCUMENT_POSITION_FOLLOWING).toBeTruthy();
+  expect(source).toHaveAttribute("href",dataset.records[0].sourceUrl);
+});
+it("declares a list-first desktop register with compact context and keeps mobile map default", async () => {
+  const css=readFileSync("src/styles.css","utf8");
+  expect(css).toMatch(/\.results-panel\s*\{[^}]*grid-area:\s*records/);
+  expect(css).toMatch(/grid-template-areas:\s*"records map"/);
+  expect(css).toMatch(/\.map-shell\s*\{[^}]*height:\s*320px/);
+  const {container}=await ready();
+  expect(container.querySelector(".workspace")).toHaveClass("view-map");
+});
