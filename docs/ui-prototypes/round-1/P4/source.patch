+.search-wrap { min-width: 0; }
+.search-wrap > label, .filter-grid label, .sort-control { font-size: 12px; font-weight: 600; color: #51594f; }
+.search-input { display: flex; align-items: center; border: 1px solid #b8bdb1; border-radius: 2px; height: 46px; background: #fff; margin-top: 5px; }
+.search-input:focus-within { border-color: var(--accent); box-shadow: 0 0 0 2px #dbc4b1; }
+.search-input span { display: grid; place-items: center; width: 38px; flex-shrink: 0; }
+.search-input svg { height: 17px; width: 17px; stroke: #627362; fill: none; stroke-width: 1.8; }
+.search-input input { min-width: 0; flex: 1; height: 100%; padding: 0 12px 0 0; border: 0; background: transparent; font-size: 14px; }
+.search-input input:focus-visible { outline-offset: -3px; }
+.search-input input::placeholder { color: #73796f; }
+.filter-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; margin: 0; }
+.filter-grid label { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
+.filter-grid.primary-filters { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+select { height: 44px; border: 1px solid #bfc3b9; background: white; border-radius: 2px; color: var(--navy); padding: 0 25px 0 10px; font-size: 12px; min-width: 0; max-width: 100%; text-overflow: ellipsis; }
+.toolbar-bottom { grid-column: 3; grid-row: 1; align-self: end; }
+.text-button { min-height: 44px; padding: 8px 3px; border: 0; background: transparent; color: var(--green); font-size: 12px; white-space: nowrap; }
+.text-button:hover { text-decoration: underline; }
+.filter-number { background: var(--soft); padding: 2px 5px; margin-left: 5px; }
+.secondary-filters { grid-column: 1 / -1; border-top: 1px solid var(--line); margin-top: 7px; }
+.secondary-filters > summary { cursor: pointer; min-height: 44px; padding: 12px 0; font-size: 12px; color: #555e52; }
+.secondary-filters[open] { padding-bottom: 16px; }
+.summary-strip { display: flex; flex-wrap: wrap; gap: 24px; padding: 13px 1px 9px; margin: 0; border-bottom: 1px solid var(--line); }
+.summary-strip > div { display: flex; align-items: baseline; gap: 7px; }
+.summary-strip strong { font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--navy); }
+.summary-strip span { font-size: 12px; color: var(--muted); }
+.data-status { display: flex; align-items: center; gap: 7px; min-height: 32px; font-size: 11px; color: #5c6458; }
+.status-dot { width: 5px; height: 5px; border-radius: 50%; background: #577359; }
+.status-date { margin-left: auto; }
+.coverage-note { margin: 4px 0 12px; padding: 12px 14px; border: 1px solid #d8cbb3; border-left: 3px solid var(--accent); background: #f8f1e2; color: #61512e; font-size: 12px; line-height: 1.75; overflow-wrap: anywhere; }
