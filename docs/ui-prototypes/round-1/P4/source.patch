+.data-disclosure { margin-top: 20px; border-top: 1px solid var(--line); padding: 8px 0; }
+.data-disclosure > summary { min-height: 44px; padding: 12px 2px; font-size: 13px; font-weight: 600; cursor: pointer; }
+.provenance { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; padding: 12px 0; }
+.provenance h2 { font-size: 25px; margin: 5px 0 11px; }
+.provenance p { font-size: 13px; color: #626c58; line-height: 1.8; margin: 9px 0; overflow-wrap: anywhere; }
+.source-info h3 { font-size: 14px; margin: 6px 0 8px; }
+.source-info a { font-size: 13px; display: inline-block; min-height: 44px; padding: 10px 0; }
+.source-info .muted { font-size: 12px; }
+.data-disclosure:target { scroll-margin-top: 20px; }
+.parcel-popup > strong { font-size: 14px; color: var(--green); }
+.parcel-popup > p { font-size: 11px !important; color: #5b6950; overflow-wrap: anywhere; margin: 7px 0 !important; }
+.parcel-popup button { display: block; min-height: 44px; width: 100%; text-align: left; border: 1px solid var(--line); padding: 9px; background: #f2f5ec; margin-top: 7px; font-size: 12px; line-height: 1.6; }
+.parcel-popup button:hover { background: #e4ecda; }
+.leaflet-interactive:focus-visible { outline: 3px solid var(--accent); outline-offset: 1px; }
+footer { max-width: 1512px; margin: 0 auto; padding: 16px 32px 22px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 18px; font-size: 12px; color: #68715f; }
+footer > span { font-size: 11px; }
