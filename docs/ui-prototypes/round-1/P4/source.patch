+.results-panel { grid-area: records; display: flex; flex-direction: column; height: 600px; }
+.has-detail .results-panel { height: 790px; }
+.results-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 18px; }
+.results-top h2 { font-size: 25px; }
+.results-top h2 span { font-family: Arial, Helvetica, sans-serif; font-size: 14px; font-weight: 700; margin-left: 10px; color: var(--green); vertical-align: middle; }
+.csv-button { min-height: 44px; padding: 8px 12px; border: 1px solid #b8c2b0; background: transparent; color: var(--green); font-size: 12px; white-space: nowrap; border-radius: 2px; }
+.csv-button:hover:not(:disabled) { background: var(--soft); }
+.sort-control { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 6px 18px; background: #f9f8f1; border-top: 1px solid var(--line); }
+.sort-control select { max-width: 210px; background: var(--surface); }
+.register-columns { display: grid; grid-template-columns: 112px minmax(0, 1fr) 180px; gap: 18px; padding: 10px 18px 10px 21px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); font-size: 11px; color: #636b5d; background: #f4f2e8; }
+.result-list { list-style: none; overflow: auto; flex: 1; min-height: 0; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: #c3c8ba transparent; }
+.result-list li + li { border-top: 1px solid #e4e2d9; }
+.result-row { display: grid; grid-template-columns: 112px minmax(0, 1fr) 180px; grid-template-rows: auto auto; gap: 3px 18px; min-height: 93px; width: 100%; text-align: left; border: 0; border-left: 3px solid transparent; background: var(--surface); padding: 15px 18px; }
+.result-row:hover { background: #f5f5ec; }
+.result-row.selected { background: #edf1e5; border-left-color: var(--accent); }
+.result-row:focus-visible { outline-offset: -4px; }
+.row-top { grid-column: 1; grid-row: 1 / 3; display: flex; flex-direction: column-reverse; justify-content: flex-end; align-items: flex-start; gap: 8px; }
+.row-top time { font-size: 14px; color: #354131; font-variant-numeric: tabular-nums; white-space: nowrap; }
+.badge { display: inline-flex; font-size: 11px; font-weight: 500; padding: 2px 6px; border: 1px solid #d4d8ca; border-radius: 2px; max-width: 100%; overflow-wrap: anywhere; }
+.badge.pending { background: #f5edd4; color: #715214; border-color: #d8c792; }
+.badge.approved { background: #e9f1e4; color: #335932; border-color: #c4d3b8; }
+.badge.refused { background: #f6e8e2; color: #813c32; border-color: #d7bcb4; }
+.badge.withdrawn { background: #ededeb; color: #555b54; }
+.badge.unknown { background: #f0f1eb; color: #505d4b; }
+.badge.neutral { background: #f3f2ed; color: #5e6557; }
+.result-row h3 { grid-column: 2; grid-row: 1; font-size: 15px; font-weight: 600; line-height: 1.45; overflow-wrap: anywhere; }
+.row-place { grid-column: 2; grid-row: 2; font-size: 13px; color: #5b6654; line-height: 1.6; overflow-wrap: anywhere; }
+.row-bottom { grid-column: 3; grid-row: 1 / 3; display: flex; flex-direction: column; gap: 7px; font-size: 12px; color: #5e6956; }
+.row-bottom > span:first-child { overflow-wrap: anywhere; min-width: 0; }
+.mapped-label { color: #3d6245; }
+.unmapped-label { color: #69695e; }
+.empty-state { padding: 35px 23px; text-align: center; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 11px; }
+.empty-state > span:not(.loading-ring) { font-size: 38px; color: #829078; }
+.empty-state h3 { font-size: 16px; }
+.empty-state p { color: var(--muted); font-size: 13px; max-width: 320px; line-height: 1.75; }
+.loading-ring { width: 28px; height: 28px; border: 2px solid #dfe3d5; border-top-color: #526842; border-radius: 50%; animation: spin 1s linear infinite; }
+@keyframes spin { to { transform: rotate(360deg); } }
+.detail-panel { grid-area: detail; padding: 18px; max-height: 400px; overflow: auto; scrollbar-width: thin; scrollbar-color: #c3c8ba transparent; border-top: 3px solid var(--accent); }
